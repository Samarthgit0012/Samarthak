# GovLens India - environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# --- Database (required) ------------------------------------------------------
# Supabase: Project -> Connect -> "Session pooler" connection string.
# If your password contains special characters, percent-encode them
# (for example "@" becomes "%40").
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS is switched on automatically for supabase.co / supabase.com hosts.
# Force it on or off with DATABASE_SSL=true|false.
# DATABASE_SSL=true

# Create the tables and load the reference data on first start (only when the
# tables are missing / empty). Safe to leave on.
AUTO_SETUP_DB=true

# --- Server -------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Token required for every write route and for /api/admin/*, sent in the
# X-Admin-Token header. Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me

# --- Optional -----------------------------------------------------------------
# Restrict API access to one frontend origin (leave unset to allow all).
# ALLOWED_ORIGIN=https://your-site.example

# Public site URL, used in the news fetcher User-Agent.
# SITE_URL=https://your-site.example

# Folder holding the built frontend (defaults to artifacts/govlens/dist/public).
# STATIC_DIR=

# Folder holding schema.sql and seed.sql (defaults to lib/db).
# DB_SQL_DIR=

# Bot-protection gates. Off by default; turn on only if the frontend sends the
# matching tokens.
# ENFORCE_SESSION_GATE=true
# SESSION_SECRET=
# TURNSTILE_SECRET_KEY=
# ENFORCE_CLOUDFLARE_ONLY=true
# CF_ORIGIN_SECRET=

# Live scheme refresh through an OpenAI-compatible API. Off by default.
# ENABLE_LIVE_REFRESH=true
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Pino log level: trace | debug | info | warn | error
# LOG_LEVEL=info
